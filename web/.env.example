# Copy this file to .env.local.
#
# To try the template with NO real Firebase project: leave the
# placeholder values below as-is, keep VITE_USE_FIREBASE_EMULATOR=true,
# and run `firebase emulators:start` alongside `npm run dev`. This
# requires a Java Runtime on your machine (the Firestore/Storage
# emulators run on it) — if you don't have Java, use a real project
# instead (see below); it's not a lesser path, just a different one.
#
# To use a real Firebase project instead: create one at
# console.firebase.google.com (the free Spark plan is enough), set
# VITE_USE_FIREBASE_EMULATOR to false, and fill in real values from
# Project settings -> General -> Your apps -> SDK setup and configuration.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-church-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-church-website
VITE_FIREBASE_STORAGE_BUCKET=demo-church-website.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Contact page ("Contáctenos" form) posts here — goes to the church.
# Create a form at https://formspree.io and paste its endpoint URL.
# Optional — the form just won't submit anywhere without it.
VITE_FORMSPREE_CONTACT_ENDPOINT=

# Feedback form (header dropdown -> "Enviar comentarios") posts here —
# app/site feedback, goes to the developer, not the church. A separate
# Formspree form from the contact one above. Optional.
VITE_FORMSPREE_FEEDBACK_ENDPOINT=

# Web push notifications (Configuración -> "Avisarme si se cancela un
# evento" — see src/lib/pushNotifications.ts). Only relevant against a
# real Firebase project (Cloud Messaging isn't emulated). Generate this
# in the Firebase console: Project settings -> Cloud Messaging -> Web
# Push certificates -> "Generate key pair". Paste the "Key pair" value
# shown there (not the sender ID above it).
VITE_FIREBASE_VAPID_KEY=
